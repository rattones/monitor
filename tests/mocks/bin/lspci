#!/usr/bin/env bash
#
# lspci falso. O backend so o usa para o nome legivel da placa, e filtra a
# saida pela classe ("VGA compatible controller"), entao o mock precisa
# devolver a linha com a classe certa - senao o nome cai para o PCI ID.
set -uo pipefail
. "${MOCK_DIR:?}/gpu-profiles.sh"
"profile_${MOCK_PROFILE:-amd_moderna}" 2>/dev/null || exit 1
case "${MOCK_PROFILE:-}" in
  amd_*)   printf '03:00.0 VGA compatible controller: Advanced Micro Devices, Inc. [AMD/ATI] [%s] (rev c1)\n' "$MOCK_GPU_NAME" ;;
  intel_*) printf '03:00.0 VGA compatible controller: Intel Corporation [%s] (rev 05)\n' "$MOCK_GPU_NAME" ;;
esac
